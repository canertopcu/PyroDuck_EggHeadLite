.page { flex-grow: 1; background-color: rgb(242, 242, 245); color: rgb(32, 35, 42); }
.dark .page { background-color: rgb(31, 34, 42); color: rgb(232, 233, 239); }
.header { align-items: center; padding-top: 30px; padding-bottom: 26px; }
.logo { font-size: 30px; -unity-font-style: bold; letter-spacing: 3px; }
.subtitle { font-size: 12px; opacity: 0.7; margin-top: 5px; white-space: normal; }
.section { margin-left: 24px; margin-right: 24px; margin-bottom: 24px; }
.section-title { font-size: 18px; -unity-font-style: bold; margin-bottom: 10px; }
.body-text { font-size: 13px; white-space: normal; margin-bottom: 10px; }
.button-row { flex-direction: row; margin-top: 8px; }
.secondary-button { flex-grow: 1; height: 34px; margin-left: 0; margin-right: 8px; }
.eyebrow { font-size: 11px; -unity-font-style: bold; letter-spacing: 2px; margin-bottom: 10px; }
.campaign-card { background-color: rgb(255, 255, 255); border-radius: 10px; overflow: hidden; }
.dark .campaign-card { background-color: rgb(43, 47, 58); }
.image-frame { overflow: hidden; height: 164px; background-color: rgb(39, 57, 63); align-items: center; justify-content: center; }
.campaign-image { width: 100%; height: 100%; position: absolute; }
.image-placeholder { font-size: 24px; -unity-font-style: bold; color: rgb(181, 235, 184); white-space: normal; -unity-text-align: middle-center; margin-left: 20px; margin-right: 20px; }
.card-content { padding-left: 18px; padding-right: 18px; padding-top: 16px; padding-bottom: 18px; }
.campaign-title { font-size: 19px; -unity-font-style: bold; margin-bottom: 8px; white-space: normal; }
.badge { color: rgb(43, 114, 68); -unity-font-style: bold; margin-bottom: 6px; white-space: normal; }
.dark .badge { color: rgb(171, 229, 170); }
.primary-button { height: 36px; background-color: rgb(174, 226, 172); color: rgb(24, 45, 33); -unity-font-style: bold; border-width: 0; border-radius: 5px; }
.primary-button:hover { background-color: rgb(193, 240, 189); }
.navigation { flex-direction: row; justify-content: center; align-items: center; margin-top: 10px; }
.dots { flex-direction: row; flex-wrap: wrap; justify-content: center; flex-shrink: 1; }
.dot { background-color: transparent; border-width: 0; font-size: 16px; width: 23px; height: 25px; padding-left: 0; padding-right: 0; }
.arrow { width: 30px; height: 28px; font-size: 20px; }
.service-row { flex-direction: row; align-items: center; margin-top: 12px; margin-bottom: 8px; }
.status { flex-grow: 1; flex-shrink: 1; font-size: 11px; opacity: 0.7; white-space: normal; }
.footer { align-items: center; margin-bottom: 28px; }
.footer-title { font-size: 13px; -unity-font-style: bold; }


.discount-ribbon {
    position: absolute;
    left: -35px;
    top: 22px;
    width: 150px;
    height: 28px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    rotate: -45deg;
    background-color: rgb(210, 43, 55);
    color: white;
    -unity-font-style: bold;
    font-size: 14px;
    -unity-text-align: middle-center;
    display: none;
}
